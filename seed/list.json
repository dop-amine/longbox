    {
      "id": "s-000",
      "n": "000",
      "title": "Before the Beginning",
      "core": false,
      "flag": false,
      "note": "Secret Wars resolves this run as much as it resolves the Avengers one — same author, same era, and threads that walk straight into the finale. Around 65 issues, and widely held to be his best Marvel work.",
