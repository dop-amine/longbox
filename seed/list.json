        {
          "id": "000-dark-reign-fantastic-four-1-5",
          "s": "Dark Reign: Fantastic Four",
          "i": "#1–5",
          "note": "Hickman's warm-up, written before his run proper",
          "alt": false
        },
        {
          "id": "000-fantastic-four-1998-570-588",
          "s": "Fantastic Four",
          "i": "(1998) #570–588",
          "note": "The run starts here",
          "alt": false
        },
